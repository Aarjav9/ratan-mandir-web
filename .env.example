# PostgreSQL connection string (Neon.tech free tier works well — see README).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Razorpay API keys. Leave these unset during local development and the
# checkout flow will automatically use a mocked order response
# (see src/lib/razorpay.ts). Fill them in with your Razorpay TEST keys
# to try a real (test-mode) payment, and LIVE keys only when going live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Same value as RAZORPAY_KEY_ID, exposed to the browser so the client-side
# Razorpay checkout widget can initialise. Only needed once you've set real
# keys above — see README "Adding real Razorpay test keys".
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Used to verify the authenticity of incoming Razorpay webhook calls.
# Set this to the "Webhook Secret" you configure in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Public site URL, used for absolute links (e.g. in Razorpay callbacks/metadata).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Shared password for the /admin panel (single-operator login, not a
# per-user account system). Compared as plaintext server-side; keep it
# out of version control.
ADMIN_PASSWORD=

# Long random string used to sign admin and customer session JWTs.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
